---
import type { PostListItem } from '../lib/api';

export interface Props {
  article: PostListItem;
  variant?: 'hero-big' | 'side-list' | 'investigation' | 'audio' | 'opinion-quote' | 'visual' | 'standard';
  indexNumber?: number | string;
}

const { article, variant = 'standard', indexNumber } = Astro.props;
const articleUrl = `/article/${article.slug || 'historic-summit-yields-accord-on-ai-safeguards'}`;
const categoryName = article?.category?.name || article?.category?.category_name || 'News';
const hasThumbnail = Boolean(article?.thumbnail_url && article.thumbnail_url.trim() !== '');
---

{variant === 'hero-big' && (
  <article class="article-card cursor-pointer bg-white dark:bg-zinc-900 rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-xs hover:shadow-xl transition group">
    <a href={articleUrl} class="block">
      <div class="relative overflow-hidden aspect-[16/9] bg-black">
        {hasThumbnail ? (
          <img 
            src={article.thumbnail_url} 
            alt={article.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-700 ease-out"
          />
        ) : (
          <div class="w-full h-full bg-black flex items-center justify-center text-zinc-500 font-serif text-xl sm:text-3xl font-bold uppercase tracking-widest p-6 text-center border-b border-zinc-800">
            {article.title}
          </div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        
        <div class="absolute top-4 left-4 flex gap-2">
          {article.isSpecialReport && (
            <span class="bg-editorial-red text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded">
              Special Report
            </span>
          )}
          <span class="bg-zinc-900/80 backdrop-blur-md text-white text-xs font-medium px-2.5 py-1 rounded">
            <i class="fa-regular fa-clock mr-1"></i> {article.readTime || '5 min read'}
          </span>
        </div>

        <div class="absolute bottom-4 left-4 right-4 text-white sm:hidden">
          <span class="text-xs text-brand-300 font-bold uppercase tracking-wider">{categoryName}</span>
          <h3 class="font-serif text-xl font-bold line-clamp-2 mt-1">
            {article.title}
          </h3>
        </div>
      </div>

      <div class="p-6 md:p-8">
        <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400 mb-3 font-medium">
          <span class="text-brand-600 dark:text-brand-400 font-bold uppercase tracking-wider">{categoryName}</span>
          <span>•</span>
          <span>By {article.author?.name || 'Editorial Team'}</span>
          <span>•</span>
          <span>{article.publish_date ? new Date(article.publish_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recently'}</span>
        </div>

        <h3 class="hidden sm:block font-serif text-2xl md:text-3xl lg:text-4xl font-bold leading-tight text-zinc-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
          {article.title}
        </h3>

        {article.subheading && (
          <p class="mt-4 text-zinc-600 dark:text-zinc-300 text-sm md:text-base leading-relaxed line-clamp-3">
            {article.subheading}
          </p>
        )}

        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
          <div class="flex items-center space-x-2">
            {article.author?.avatar_url && (
              <img src={article.author.avatar_url} class="w-8 h-8 rounded-full object-cover" alt={article.author.name} />
            )}
            <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">{article.author?.name || 'Staff Reporter'}</span>
          </div>
          <span class="text-xs font-bold text-brand-600 dark:text-brand-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
            Read Full Story <i class="fa-solid fa-arrow-right"></i>
          </span>
        </div>
      </div>
    </a>
  </article>
)}

{variant === 'side-list' && (
  <article class="pt-4 first:pt-0 group cursor-pointer">
    <a href={articleUrl} class="flex gap-4 items-start">
      {indexNumber && (
        <span class="font-serif text-2xl font-black text-zinc-300 dark:text-zinc-700 shrink-0 w-6">
          {typeof indexNumber === 'number' && indexNumber < 10 ? `0${indexNumber}` : indexNumber}
        </span>
      )}
      <div class="flex-1 min-w-0">
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
          {categoryName}
        </span>
        <h4 class="font-serif font-bold text-sm md:text-base text-zinc-900 dark:text-zinc-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2 mt-0.5">
          {article.title}
        </h4>
        <div class="flex items-center gap-3 mt-2 text-[11px] text-zinc-500">
          <span>{article.publish_date ? new Date(article.publish_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Today'}</span>
          <span>•</span>
          <span>{article.readTime || '3 min read'}</span>
        </div>
      </div>
      {hasThumbnail ? (
        <img src={article.thumbnail_url} alt={article.title} class="w-16 h-16 rounded-lg object-cover shrink-0" />
      ) : (
        <div class="w-16 h-16 rounded-lg bg-black shrink-0 flex items-center justify-center text-zinc-500 text-[10px] font-serif font-bold tracking-widest text-center p-1 border border-zinc-800">
          CHRONICLE
        </div>
      )}
    </a>
  </article>
)}

{variant === 'standard' && (
  <article class="article-card bg-white dark:bg-zinc-900 rounded-xl p-5 border border-zinc-200 dark:border-zinc-800 shadow-xs hover:shadow-lg transition flex flex-col justify-between group">
    <a href={articleUrl} class="block h-full flex flex-col justify-between">
      <div>
        <div class="aspect-video rounded-lg overflow-hidden mb-3 bg-black relative flex items-center justify-center">
          {hasThumbnail ? (
            <img src={article.thumbnail_url} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          ) : (
            <div class="w-full h-full bg-black flex items-center justify-center text-zinc-500 text-xs font-serif font-bold uppercase tracking-wider p-4 text-center">
              {categoryName}
            </div>
          )}
        </div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
          {categoryName}
        </span>
        <h4 class="font-serif font-bold text-base text-zinc-900 dark:text-zinc-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2 mt-1">
          {article.title}
        </h4>
        {article.subheading && (
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 line-clamp-2">
            {article.subheading}
          </p>
        )}
      </div>
      <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800 flex justify-between items-center text-[11px] text-zinc-500">
        <span>By {article.author?.name || 'Staff'}</span>
        <i class="fa-solid fa-chevron-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
      </div>
    </a>
  </article>
)}
