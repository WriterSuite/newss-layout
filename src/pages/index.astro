---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPosts, getGroupedCategoryPosts, getCategories, getSiteConfig } from '../lib/api';

const siteConfig = await getSiteConfig();
const { items: posts } = await getPosts(1, 12);
const groupedCategories = await getGroupedCategoryPosts(4);
const categories = await getCategories();

const heroPost = posts[0] || {
  id: "hero-big-post",
  title: "Historic Summit Yields Accord on AI Safeguards and Clean Energy Transition",
  subheading: "World leaders gathered in Geneva have finalized an unprecedented framework governing advanced artificial intelligence deployment, paired with a $400 billion global fund dedicated to accelerating deep-tech clean energy projects across developing nations.",
  slug: "historic-summit-yields-accord-on-ai-safeguards",
  thumbnail_url: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=1200&auto=format&fit=crop",
  publish_date: "2026-08-09T10:00:00.000Z",
  category: { name: "World & Climate", slug: "world" },
  author: {
    name: "Sarah Jenkins",
    avatar_url: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop",
    tagline: "Chief Foreign Editor"
  },
  readTime: "7 min read",
  isSpecialReport: true
};

const sidePosts = posts.slice(1, 5);
const spotlightPosts = posts.slice(5, 8);
const visualPosts = posts.slice(8, 11).length > 0 ? posts.slice(8, 11) : posts.slice(1, 4);
---

<BaseLayout 
  title={`${siteConfig.site_title || 'The Global Chronicle'} - International News & Editorial`}
  description={siteConfig.site_description || 'Authoritative global publication covering geopolitics, artificial intelligence, markets, climate science, and cultural dispatches.'}
  currentCategorySlug="all"
>
  <!-- SECTION 1: CATEGORY FEATURED HIGHLIGHT (1 BIG POST + 4 LIST POSTS) -->
  <section id="category-section" class="scroll-mt-24">
      <div class="flex items-center justify-between border-b-2 border-zinc-900 dark:border-zinc-100 pb-2 mb-6">
          <div class="flex items-center gap-3">
              <span class="w-3 h-3 bg-editorial-red inline-block"></span>
              <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight uppercase" id="current-category-title">
                  Lead Stories & Featured Digest
              </h2>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-zinc-500">
              <span>Filter:</span>
              <select id="category-select-filter" onchange="if(this.value === 'all') window.location.href='/'; else window.location.href='/category/' + this.value;" class="bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 rounded px-2 py-1 outline-none border border-zinc-300 dark:border-zinc-700">
                  <option value="all">All Categories</option>
                  {categories.map((cat) => (
                    <option value={cat.slug}>{cat.name || cat.category_name}</option>
                  ))}
              </select>
          </div>
      </div>

      <!-- LAYOUT: 1 BIG POST (LEFT) + 4 LIST POSTS (RIGHT) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 xl:col-span-8">
              <ArticleCard article={heroPost} variant="hero-big" />
          </div>

          <div class="lg:col-span-5 xl:col-span-4 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
                  <h3 class="font-serif font-bold text-lg text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
                      <i class="fa-solid fa-bolt text-amber-500"></i> Top Headlines List
                  </h3>
                  <span class="text-xs text-zinc-500 font-mono">Live Feed</span>
              </div>

              <div id="side-posts-list" class="space-y-4 divide-y divide-zinc-100 dark:divide-zinc-800/80">
                  {sidePosts.map((post, idx) => (
                      <ArticleCard article={post} variant="side-list" indexNumber={idx + 1} />
                  ))}
              </div>
          </div>
      </div>
  </section>

  <!-- SECTION 2: CATEGORY FEATURE SPOTLIGHT (REPLACED DUMMY POSTS WITH CATEGORY POSTS) -->
  <section class="border-t border-zinc-200 dark:border-zinc-800 pt-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-8">
          <div>
              <span class="text-xs font-bold text-brand-600 dark:text-brand-400 uppercase tracking-widest">Curated Spotlight</span>
              <h2 class="font-serif text-3xl font-bold tracking-tight">Category Spotlight Stories</h2>
          </div>
          <p class="text-xs text-zinc-500 max-w-md">Featured dispatches dynamically fetched from our publication desks.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {spotlightPosts.map((post) => (
              <ArticleCard article={post} variant="standard" />
          ))}
      </div>
  </section>

  <!-- SECTION 3: MULTI-CATEGORY GROUPED SECTIONS -->
  <section class="border-t border-zinc-200 dark:border-zinc-800 pt-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
          <div>
              <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">Explore By Category Desks</h2>
              <p class="text-xs text-zinc-500">Live dispatches from our global desks</p>
          </div>
      </div>

      <div class="space-y-10">
        {groupedCategories.map((group) => (
          <div>
            <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-2 mb-4">
              <h3 class="font-serif font-bold text-xl text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-brand-600"></span>
                <a href={`/category/${group.slug}`} class="hover:text-brand-600 transition">{group.category_name}</a>
              </h3>
              <a href={`/category/${group.slug}`} class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">
                View All {group.category_name} &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {group.posts.map((post) => (
                <ArticleCard article={post} variant="standard" />
              ))}
            </div>
          </div>
        ))}
      </div>
  </section>

  <!-- SECTION 4: VISUAL DISPATCHES (REPLACED DUMMY POSTS WITH CATEGORY POSTS + BLACK BG FOR MISSING THUMBNAILS) -->
  <section class="border-t border-zinc-200 dark:border-zinc-800 pt-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-6">
          <div>
              <div class="flex items-center gap-2 text-xs font-bold text-rose-600 dark:text-rose-400 uppercase tracking-widest">
                  <i class="fa-solid fa-camera"></i> Visual Dispatches
              </div>
              <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">Featured Field Reports</h2>
          </div>
          <p class="text-xs text-zinc-500 max-w-md">Highlighting stories and reporting across our editorial desks.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {visualPosts.map((post) => {
              const catName = post?.category?.name || post?.category?.category_name || 'Dispatch';
              const hasThumb = Boolean(post?.thumbnail_url && post.thumbnail_url.trim() !== '');
              return (
                  <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] bg-black cursor-pointer shadow-lg">
                      <a href={`/article/${post.slug}`} class="block h-full">
                          {hasThumb ? (
                              <img src={post.thumbnail_url} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-700 opacity-90 group-hover:opacity-100" />
                          ) : (
                              <div class="w-full h-full bg-black flex items-center justify-center p-6 text-center text-zinc-500 font-serif font-bold text-lg border border-zinc-800">
                                  {post.title}
                              </div>
                          )}
                          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent p-6 flex flex-col justify-between">
                              <div class="flex justify-between items-center">
                                  <span class="bg-white/20 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded">
                                      {catName}
                                  </span>
                                  <span class="text-white/80 text-xs font-mono"><i class="fa-solid fa-newspaper mr-1"></i> Story</span>
                              </div>
                              <div>
                                  <span class="text-rose-400 text-xs font-semibold uppercase tracking-wider">{catName}</span>
                                  <h3 class="font-serif text-xl font-bold text-white mt-1 group-hover:text-rose-200 transition line-clamp-2">
                                      {post.title}
                                  </h3>
                              </div>
                          </div>
                      </a>
                  </div>
              );
          })}
      </div>
  </section>

  <!-- NEWSLETTER SUBSCRIPTION -->
  <Newsletter />
</BaseLayout>
